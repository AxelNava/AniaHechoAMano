// ==========================================
// ESQUEMA PRISMA PARA NEGOCIO DE PAPELERÍA CREATIVA
// ==========================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------
// ENUMS (Reemplazan los CHECK constraints)
// ------------------------------------------

enum TipoComponente {
  MATERIAL
  ELEMENTO_ELABORADO
  SERVICIO
}

enum TipoTiempo {
  OBTENCION_PROVEEDOR
  ELABORACION_MANUAL
  DISENO
}

enum EstadoPedido {
  COTIZANDO
  ESPERANDO_ANTICIPO
  CONFIRMADO
  EN_PROCESO
  TERMINADO
  ENTREGADO
  CANCELADO
}

// ------------------------------------------
// MODELOS
// ------------------------------------------

model CategoriaProducto {
  id          Int      @id @default(autoincrement())
  nombre      String   @db.VarChar(100)
  descripcion String?  @db.Text
  activo      Boolean  @default(true)

  // Relaciones inversas
  articulos   ArticuloPedido[]

  @@map("categorias_producto")
}

model Componente {
  id                   Int            @id @default(autoincrement())
  tipo                 TipoComponente
  nombre               String         @db.VarChar(150)
  descripcion          String?        @db.Text
  unidadMedida         String         @map("unidad_medida") @db.VarChar(50)
  requierePedidoPrevio Boolean        @default(false) @map("requiere_pedido_previo")
  activo               Boolean        @default(true)

  // Relaciones inversas
  historialCostos      HistorialCostoComponente[]
  historialTiempos     HistorialTiempoComponente[]
  articulos            ComponentePorArticulo[]

  @@map("componentes")
}

model HistorialCostoComponente {
  id            Int        @id @default(autoincrement())
  componenteId  Int        @map("componente_id")
  costo         Decimal    @db.Decimal(10, 2)
  proveedor     String?    @db.VarChar(150)
  fechaRegistro DateTime   @default(now()) @map("fecha_registro") @db.Timestamp(6)

  // Relaciones
  componente    Componente @relation(fields: [componenteId], references: [id])

  @@index([fechaRegistro]) // Índice para consultas rápidas de IA
  @@map("historial_costos_componentes")
}

model HistorialTiempoComponente {
  id               Int        @id @default(autoincrement())
  componenteId     Int        @map("componente_id")
  tipoTiempo       TipoTiempo @map("tipo_tiempo")
  minutosEstimados Int        @map("minutos_estimados")
  notas            String?    @db.Text
  fechaRegistro    DateTime   @default(now()) @map("fecha_registro") @db.Timestamp(6)

  // Relaciones
  componente       Componente @relation(fields: [componenteId], references: [id])

  @@index([fechaRegistro]) // Índice para consultas rápidas de IA
  @@map("historial_tiempos_componentes")
}

model Cliente {
  id                Int       @id @default(autoincrement())
  nombre            String    @db.VarChar(150)
  telefono          String?   @db.VarChar(20)
  redSocialContacto String?   @map("red_social_contacto") @db.VarChar(100)
  notas             String?   @db.Text
  fechaRegistro     DateTime  @default(now()) @map("fecha_registro") @db.Timestamp(6)

  // Relaciones inversas
  pedidos           Pedido[]

  @@map("clientes")
}

model Pedido {
  id                   Int          @id @default(autoincrement())
  clienteId            Int          @map("cliente_id")
  fechaSolicitud       DateTime     @default(now()) @map("fecha_solicitud") @db.Timestamp(6)
  fechaEntregaAcordada DateTime     @map("fecha_entrega_acordada") @db.Timestamp(6)
  estado               EstadoPedido?
  precioFinalTotal     Decimal?     @map("precio_final_total") @db.Decimal(10, 2)
  anticipoPagado       Decimal?     @default(0.00) @map("anticipo_pagado") @db.Decimal(10, 2)
  notasAdmin           String?      @map("notas_admin") @db.Text

  // Relaciones
  cliente              Cliente      @relation(fields: [clienteId], references: [id])
  articulos            ArticuloPedido[]

  @@map("pedidos")
}

model ArticuloPedido {
  id                         Int                @id @default(autoincrement())
  pedidoId                   Int                @map("pedido_id")
  categoriaId                Int?               @map("categoria_id")
  descripcionCliente         String             @map("descripcion_cliente") @db.Text
  precioEstimadoIa           Decimal?           @map("precio_estimado_ia") @db.Decimal(10, 2)
  precioFijadoAdmin          Decimal?           @map("precio_fijado_admin") @db.Decimal(10, 2)
  tiempoTotalEstimadoMinutos Int?               @map("tiempo_total_estimado_minutos")
  fotoReferenciaUrl          String?            @map("foto_referencia_url") @db.VarChar(255)

  // Relaciones
  pedido                     Pedido             @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  categoria                  CategoriaProducto? @relation(fields: [categoriaId], references: [id])
  componentes                ComponentePorArticulo[]

  @@map("articulos_pedido")
}

model ComponentePorArticulo {
  id                         Int            @id @default(autoincrement())
  articuloPedidoId           Int            @map("articulo_pedido_id")
  componenteId               Int?           @map("componente_id")
  cantidad                   Decimal        @db.Decimal(10, 2)
  costoUnitarioCongelado     Decimal        @map("costo_unitario_congelado") @db.Decimal(10, 2)
  minutosUnitariosCongelados Int            @map("minutos_unitarios_congelados")

  // Relaciones
  articulo                   ArticuloPedido @relation(fields: [articuloPedidoId], references: [id], onDelete: Cascade)
  componente                 Componente?    @relation(fields: [componenteId], references: [id])

  @@index([articuloPedidoId]) // Índice para consultas rápidas
  @@map("componentes_por_articulo")
}
